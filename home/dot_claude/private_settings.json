{
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@mattpocock": true,
    "temporal@temporal-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "temporal-marketplace": {
      "source": {
        "source": "github",
        "repo": "temporalio/claude-temporal-plugin"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "outputStyle": "simple-english",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf 'SIMPLE ENGLISH SKILL ACTIVE AUTOMATICALLY\\n\\nFollow these writing rules without waiting for the user to name the skill. The full skill, with the rule catalog and the check mode, is at ~/.claude/skills/simple-english/SKILL.md. Read it for a compliance check or for strict mode.\\n\\n'; cat ~/.claude/hooks/simple-english-system-prompt.md",
            "timeout": 5,
            "statusMessage": "Loading Simple English..."
          }
        ]
      }
    ]
  }
}
