# External dependencies fetched by `chezmoi apply`.
#
#   - archive:                       shell/editor plugins as pinned tarballs.
#   - file / archive-file:           binaries from GitHub releases or
#                                    dl.k8s.io. Cross-platform via
#                                    .chezmoi.os / .chezmoi.arch.

# --- Plugins (pinned release tarballs) -----------------------------------
# Pinned to fixed tags/commits and fetched as archives. `git-repo` externals
# trip over each other on a fresh box when none of the target dirs exist
# yet, so we trade rolling HEAD for deterministic, single-shot installs.
# Bump the version/sha here when an update is wanted.

[".zsh/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/refs/tags/v0.7.1.tar.gz"
    stripComponents = 1
    exact = true
    refreshPeriod = "168h"

[".tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/refs/tags/v3.1.0.tar.gz"
    stripComponents = 1
    exact = true
    refreshPeriod = "168h"

# --- Binaries (release downloads) ---------------------------------------
# Pinned versions instead of `gitHubLatestReleaseAssetURL` so a fresh
# `chezmoi apply` makes zero GitHub API calls. The unauthenticated limit
# is 60/hr — one apply with `latest` lookups burns ~8 of them and a
# freshly-provisioned VM that retries a few times can lock itself out
# for ~hour. Bump versions below by hand (or via a bump script).
# Naming conventions vary per tool; OS/arch mapping is below.

{{- $arch := "x86_64" -}}
{{- if eq .chezmoi.arch "arm64" -}}{{- $arch = "aarch64" -}}{{- end -}}

# Rust release targets. Prefer musl (statically linked, portable across
# distros) and fall back to gnu only where a project ships no musl build for
# the arch. As of the pinned versions, starship/fd/bat publish musl for both
# x86_64 and aarch64, but ripgrep has no aarch64 musl asset (gnu only) — so it
# gets its own target.
{{- $rustTarget := "" -}}
{{- $ripgrepTarget := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $rustTarget = printf "%s-apple-darwin" $arch -}}
{{-   $ripgrepTarget = $rustTarget -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $rustTarget = printf "%s-unknown-linux-musl" $arch -}}
{{-   $ripgrepTarget = $rustTarget -}}
{{-   if eq $arch "aarch64" -}}
{{-     $ripgrepTarget = printf "%s-unknown-linux-gnu" $arch -}}
{{-   end -}}
{{- end -}}

# Pinned versions — bump these to update.
{{- $nvimVersion      := "v0.12.2" -}}
{{- $starshipVersion  := "v1.25.1" -}}
{{- $ripgrepVersion   := "15.1.0"  -}}
{{- $fdVersion        := "v10.4.2" -}}
{{- $batVersion       := "v0.26.1" -}}
{{- $fzfVersion       := "v0.72.0" -}}
{{- $kindVersion      := "v0.31.0" -}}
{{- $k9sVersion       := "v0.50.18" -}}
{{- $mpSkillsRev      := "c55ee46073ed923f86ce59a5eb3b6d895095d1b7" -}}

# nvim — full distribution (binary needs lib/ + share/ siblings, lives
# in ~/.local/opt/nvim and is added to PATH by dot_shell.env).
{{- $nvimOs := .chezmoi.os -}}
{{- if eq $nvimOs "darwin" -}}{{- $nvimOs = "macos" -}}{{- end -}}
{{- $nvimArch := "x86_64" -}}
{{- if eq .chezmoi.arch "arm64" -}}{{- $nvimArch = "arm64" -}}{{- end }}

[".local/opt/nvim"]
    type = "archive"
    url = {{ printf "https://github.com/neovim/neovim/releases/download/%s/nvim-%s-%s.tar.gz" $nvimVersion $nvimOs $nvimArch | quote }}
    stripComponents = 1
    exact = true
    refreshPeriod = "168h"

# starship — flat archive (binary at archive root).
{{ if $rustTarget -}}
[".local/bin/starship"]
    type = "archive-file"
    url = {{ printf "https://github.com/starship/starship/releases/download/%s/starship-%s.tar.gz" $starshipVersion $rustTarget | quote }}
    executable = true
    path = "starship"
    refreshPeriod = "168h"
{{- end }}

# ripgrep — versioned dir; build its name from the pinned version so
# archive-file can point at the binary inside without globbing.
{{ if $ripgrepTarget -}}
{{- $rgDir := printf "ripgrep-%s-%s" $ripgrepVersion $ripgrepTarget }}
[".local/bin/rg"]
    type = "archive-file"
    url = {{ printf "https://github.com/BurntSushi/ripgrep/releases/download/%s/%s.tar.gz" $ripgrepVersion $rgDir | quote }}
    executable = true
    path = "{{ $rgDir }}/rg"
    refreshPeriod = "168h"
{{- end }}

# fd — same pattern.
{{ if $rustTarget -}}
{{- $fdDir := printf "fd-%s-%s" $fdVersion $rustTarget }}
[".local/bin/fd"]
    type = "archive-file"
    url = {{ printf "https://github.com/sharkdp/fd/releases/download/%s/%s.tar.gz" $fdVersion $fdDir | quote }}
    executable = true
    path = "{{ $fdDir }}/fd"
    refreshPeriod = "168h"
{{- end }}

# bat — same pattern.
{{ if $rustTarget -}}
{{- $batDir := printf "bat-%s-%s" $batVersion $rustTarget }}
[".local/bin/bat"]
    type = "archive-file"
    url = {{ printf "https://github.com/sharkdp/bat/releases/download/%s/%s.tar.gz" $batVersion $batDir | quote }}
    executable = true
    path = "{{ $batDir }}/bat"
    refreshPeriod = "168h"
{{- end }}

# fzf — flat tarball with a single binary. Asset name drops the leading
# "v" from the tag.
{{- $fzfAssetVersion := trimPrefix "v" $fzfVersion }}
[".local/bin/fzf"]
    type = "archive-file"
    url = {{ printf "https://github.com/junegunn/fzf/releases/download/%s/fzf-%s-%s_%s.tar.gz" $fzfVersion $fzfAssetVersion .chezmoi.os .chezmoi.arch | quote }}
    executable = true
    path = "fzf"
    refreshPeriod = "168h"

# kubectl — pinned to whatever dl.k8s.io says is current stable. Not on
# GitHub so it doesn't count against the rate limit.
{{ $kubectlVersion := output "curl" "-fsSL" "https://dl.k8s.io/release/stable.txt" | trim -}}
[".local/bin/kubectl"]
    type = "file"
    url = {{ printf "https://dl.k8s.io/release/%s/bin/%s/%s/kubectl" $kubectlVersion .chezmoi.os .chezmoi.arch | quote }}
    executable = true
    refreshPeriod = "168h"

# kind — single binary asset.
[".local/bin/kind"]
    type = "file"
    url = {{ printf "https://github.com/kubernetes-sigs/kind/releases/download/%s/kind-%s-%s" $kindVersion .chezmoi.os .chezmoi.arch | quote }}
    executable = true
    refreshPeriod = "168h"

# k9s — capitalised OS in asset name (Darwin/Linux).
{{ $k9sOs := title .chezmoi.os -}}
[".local/bin/k9s"]
    type = "archive-file"
    url = {{ printf "https://github.com/derailed/k9s/releases/download/%s/k9s_%s_%s.tar.gz" $k9sVersion $k9sOs .chezmoi.arch | quote }}
    executable = true
    path = "k9s"
    refreshPeriod = "168h"

# --- Claude Code skills (vendored from upstream) ------------------------
# Each skill lands in ~/.claude/skills/<name>/ as its own archive external.
# Skill repos are laid out differently, so url/include/stripComponents are
# per-entry, not global. Entries sharing a url are fetched once and served
# from cache, so many skills from one repo cost one download.
#
# mattpocock/skills: pinned by commit SHA ($mpSkillsRev above) — upstream
# cuts no tags. Layout is skills-<sha>/skills/<category>/<name>/, so
# stripComponents = 4 drops those levels and the skill's files land
# directly under the target. The include glob wildcards the category
# rather than naming it: upstream moves skills between categories (and out
# of in-progress/) without renaming them, and a glob that matches nothing
# yields an empty directory with no error, so a hardcoded category breaks
# silently on the next bump. No skill name is duplicated across categories
# upstream, so the wildcard stays unambiguous. Add a skill by appending its
# name below; bump $mpSkillsRev to update.
#
# Deliberately excluded: ask-matt (router; its flow names skills not
# installed here), setup-matt-pocock-skills (writes docs/agents/
# issue-tracker.md, hand-maintained instead — see dot_claude/templates/
# issue-tracker-jira.md), and everything under misc/, in-progress/,
# deprecated/.
{{- $mpUrl := printf "https://github.com/mattpocock/skills/archive/%s.tar.gz" $mpSkillsRev -}}
{{- $mpSkills := list

      "grill-me"
      "grilling"
      "handoff"
      "teach"
      "to-questionnaire"
      "wait-what"
      "writing-for-agents"

      "code-review"
      "codebase-design"
      "diagnosing-bugs"
      "domain-modeling"
      "grill-with-docs"
      "implement"
      "improve-codebase-architecture"
      "prototype"
      "research"
      "resolving-merge-conflicts"
      "tdd"
      "to-spec"
      "to-tickets"
      "triage"
      "wayfinder"
-}}
{{ range $mpSkills }}
[".claude/skills/{{ . }}"]
    type = "archive"
    url = {{ $mpUrl | quote }}
    include = ["{{ printf "**/skills/*/%s/**" . }}"]
    stripComponents = 4
    exact = true
    refreshPeriod = "168h"
{{ end }}
# Skills from other repos: add explicit blocks here. They will not share
# the mattpocock layout, so set url/include/stripComponents to match that
# repo's tarball (one block per skill, same shape as the externals above).

# cloudflare/security-audit-skill: SKILL.md and its supporting files sit at
# the tarball root, so stripComponents = 1 lands them directly under the
# target. Pinned by commit SHA — upstream cuts no tags, and archive-by-SHA
# makes zero GitHub API calls (same reasoning as the binaries above). Dir
# matches the in-skill name "security-audit"; bump the SHA to update.
{{- $sasRev := "8bac42001ddd90a4dcd8d5a5045199283a8eba75" }}
[".claude/skills/security-audit"]
    type = "archive"
    url = {{ printf "https://github.com/cloudflare/security-audit-skill/archive/%s.tar.gz" $sasRev | quote }}
    stripComponents = 1
    exact = true
    refreshPeriod = "168h"

# temporalio/skill-temporal-developer: SKILL.md and its supporting files sit
# at the tarball root, so stripComponents = 1 lands them directly under the
# target. Pinned by commit SHA — upstream cuts no tags, and archive-by-SHA
# makes zero GitHub API calls. Dir matches the in-skill name
# "temporal-developer"; bump the SHA to update.
{{- $tdRev := "4f7b14626c56d06574564cd4d265bbcb6425a21c" }}
[".claude/skills/temporal-developer"]
    type = "archive"
    url = {{ printf "https://github.com/temporalio/skill-temporal-developer/archive/%s.tar.gz" $tdRev | quote }}
    stripComponents = 1
    exact = true
    refreshPeriod = "168h"

# cursor/plugins: monorepo of plugins; only one skill is wanted, at
# pstack/skills/unslop/, so include narrows to it and stripComponents = 4 drops
# root/pstack/skills/unslop. Pinned by commit SHA — upstream cuts no tags, and
# archive-by-SHA makes zero GitHub API calls. The skill sets
# disable-model-invocation, so it never loads on its own: call /unslop to use it.
{{- $unslopRev := "e8d856f0273b42ebafe0ec3546bd645709e7c1b0" }}
[".claude/skills/unslop"]
    type = "archive"
    url = {{ printf "https://github.com/cursor/plugins/archive/%s.tar.gz" $unslopRev | quote }}
    include = ["**/pstack/skills/unslop/**"]
    stripComponents = 4
    exact = true
    refreshPeriod = "168h"

# AminBlg/SimpleEnglish: multi-purpose repo (plugin, hooks, evals); only the
# skill is wanted, at skills/simple-english/, so include narrows to it and
# stripComponents = 3 drops root/skills/simple-english. Pinned to a release tag;
# the archive URL makes zero GitHub API calls, so fresh VMs dodge the rate limit.
# The version is stored bare because the tag carries a leading v but the tarball
# root does not: tag v2.0.0 unpacks to SimpleEnglish-2.0.0.
{{- $seVer := "2.0.0" }}
[".claude/skills/simple-english"]
    type = "archive"
    url = {{ printf "https://github.com/AminBlg/SimpleEnglish/archive/refs/tags/v%s.tar.gz" $seVer | quote }}
    include = ["**/skills/simple-english/**"]
    stripComponents = 3
    exact = true
    refreshPeriod = "168h"

# Same tarball, two more files served from the same cached download: the
# condensed rule set that the SessionStart hook cats (see dot_claude/
# private_settings.json), and the output style, which Claude Code only picks
# up from ~/.claude/output-styles/. The upstream plugin runs a Node wrapper
# around the prompt file; a `cat` in the hook does the same job with no
# runtime dependency, so only the file is vendored.
{{- $seRoot := printf "SimpleEnglish-%s" $seVer }}
[".claude/hooks/simple-english-system-prompt.md"]
    type = "archive-file"
    url = {{ printf "https://github.com/AminBlg/SimpleEnglish/archive/refs/tags/v%s.tar.gz" $seVer | quote }}
    path = "{{ $seRoot }}/prompts/system-prompt.md"
    refreshPeriod = "168h"

[".claude/output-styles/simple-english.md"]
    type = "archive-file"
    url = {{ printf "https://github.com/AminBlg/SimpleEnglish/archive/refs/tags/v%s.tar.gz" $seVer | quote }}
    path = "{{ $seRoot }}/output-styles/simple-english.md"
    refreshPeriod = "168h"
